# Genius Lyrics Scraper API - Environment Variables Template
# Copy this to .env and fill in your tokens

# Genius API Token (for future use)
GENIUS_TOKEN=your_genius_token_here

# Browserless.io Token (optional - for premium Genius scraping)
# Sign up at https://browserless.io to get your token
BROWSERLESS_TOKEN=your_browserless_token_here

# Environment
NODE_ENV=production

# API Settings
PORT=3000
API_TIMEOUT=30000

# Rate Limiting (calls per hour)
RATE_LIMIT=100

# Fallback to lyrics.ovh if scraping fails
ENABLE_API_FALLBACK=true
